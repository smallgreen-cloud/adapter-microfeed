+// Degraded no-R2 mode: some accounts cannot use R2 at all (Cloudflare API
+// error 10042). With MICROFEED_DISABLE_R2=1, initialization skips every R2
+// check and creation, and the Worker deploys without the MEDIA_BUCKET
+// binding. Media uploads and media serving are unavailable at runtime.
+export function mediaStorageDisabled(): boolean {
+  return process.env.MICROFEED_DISABLE_R2 === "1";
+}
+
+async function stripBuiltR2Bindings(): Promise<void> {
+  const raw = await readFile(builtWranglerConfigPath, "utf8");
+  const config = JSON.parse(raw) as Record<string, unknown>;
+  if (!("r2_buckets" in config)) {
+    return;
+  }
+  const stripped = Object.fromEntries(
+    Object.entries(config).filter(([key]) => key !== "r2_buckets"),
+  );
+  await writeFile(
+    builtWranglerConfigPath,
+    `${JSON.stringify(stripped, null, 2)}\n`,
+    "utf8",
+  );
+}
